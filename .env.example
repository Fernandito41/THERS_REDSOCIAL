# Variables de entorno de la raíz del monorepo — copiar a .env y ajustar.
# Solo las consume `docker compose` (docker-compose.yml). No contiene secretos
# de aplicación: JWT_SECRET_KEY y DATABASE_URL viven en backend/.env.
# .env nunca se sube al repositorio (HB-001 §19.1/§20, regla innegociable).

# Puerto del HOST donde se publica PostgreSQL del contenedor (dentro del
# contenedor siempre es 5432). Cambiarlo si el 5432 del host ya está ocupado
# por un PostgreSQL nativo instalado — síntoma típico:
# "Ports are not available: bind: address already in use" al hacer
# `docker compose up -d`, o un `docker compose up` que arranca pero contra el
# PostgreSQL equivocado.
#
# IMPORTANTE: este valor y el puerto de DATABASE_URL en backend/.env tienen que
# coincidir. Ver docs/LOCAL_DEV_SETUP.md §Troubleshooting.
POSTGRES_PORT=5433
