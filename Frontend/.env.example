# Variables de entorno del Frontend — copiar a .env y ajustar valores locales.
# .env nunca se sube al repositorio (HB-001 §19.1/§20, regla innegociable).
# Vite solo expone al cliente las variables con prefijo VITE_.

# URL base de la API del backend (incluye el prefijo /api).
# Si no se define, Frontend/src/shared/lib/api.js usa http://127.0.0.1:5000/api
# y lo advierte por consola.
VITE_API_URL=http://127.0.0.1:5000/api

# "Continuar con Google" (ADR-012-google-sign-in.md). Client ID de OAuth
# creado en Google Cloud Console (Credentials > OAuth client ID > Web
# application) -- NO es secreto, es el mismo valor que
# GOOGLE_CLIENT_ID en backend/.env.example (el backend lo usa como `aud`
# esperada al verificar el ID Token). Sin esta variable,
# GoogleSignInButton.jsx no puede inicializar Google Identity Services --
# lo advierte por consola, sin romper el resto del formulario de
# Login/Register.
VITE_GOOGLE_CLIENT_ID=
