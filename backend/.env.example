# Variables de entorno del backend — copiar a .env y ajustar valores locales.
# .env nunca se sube al repositorio (HB-001 §19.1/§20, regla innegociable).
# Ninguna variable de este archivo debe contener un secreto real.

# Clave usada para firmar los JWT emitidos por flask_jwt_extended.
# Si no se define, backend/app/config.py usa un valor de desarrollo inseguro
# y lo advierte por stderr al arrancar la app — ver BACKEND_ARCHITECTURE.md §20.
JWT_SECRET_KEY=

# Cadena de conexión a PostgreSQL, formato (driver psycopg v3 — nótese
# "+psycopg", no solo "postgresql://", ver requirements.txt):
# postgresql+psycopg://usuario:password@host:puerto/nombre_bd
# Sin esta variable, la app arranca pero cualquier operación contra la base de
# datos falla — no hay un valor de desarrollo por defecto que la sustituya (a
# diferencia de JWT_SECRET_KEY) porque no hay una base "de desarrollo" segura
# que asumir. Ver docs/architecture/DATABASE_ARCHITECTURE.md.
DATABASE_URL=
