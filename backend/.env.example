# Variables de entorno del backend — copiar a .env y ajustar valores locales.
# .env nunca se sube al repositorio (HB-001 §19.1/§20, regla innegociable).
# Ninguna variable de este archivo debe contener un secreto real.

# Clave usada para firmar los JWT emitidos por flask_jwt_extended.
# Si no se define AQUÍ, backend/app/config.py exige la variable de abajo
# (ALLOW_INSECURE_JWT_DEV_FALLBACK) para arrancar con un valor de desarrollo
# inseguro — ver BACKEND_ARCHITECTURE.md §20. Poner un valor real acá para
# dejar de depender del fallback, incluso en local.
JWT_SECRET_KEY=

# SOLO para desarrollo local: permite que config.py use un JWT_SECRET_KEY de
# desarrollo inseguro cuando la variable de arriba está vacía, en vez de
# fallar al arrancar. Viene en "1" acá para que `cp .env.example .env` siga
# funcionando sin pasos extra en local.
# NUNCA definir esta variable en Render ni en ningún entorno desplegado —
# quien la defina ahí está aceptando a propósito que cualquiera con acceso a
# este repositorio pueda firmar JWTs válidos para cualquier usuario.
ALLOW_INSECURE_JWT_DEV_FALLBACK=1

# Cadena de conexión a PostgreSQL, formato (driver psycopg v3 — nótese
# "+psycopg", no solo "postgresql://", ver requirements.txt):
# postgresql+psycopg://usuario:password@host:puerto/nombre_bd
# Sin esta variable, la app arranca pero cualquier operación contra la base de
# datos falla — no hay un valor de desarrollo por defecto que la sustituya (a
# diferencia de JWT_SECRET_KEY) porque no hay una base "de desarrollo" segura
# que asumir. Ver docs/architecture/DATABASE_ARCHITECTURE.md.
DATABASE_URL=

# --- Correo electrónico (Resend) — ADR-009-password-reset-and-email-verification.md ---
#
# Clave de API de Resend (https://resend.com/api-keys). Sin esta variable,
# infrastructure/email/resend_email_sender.py nunca se instancia -- el
# backend usa automáticamente un NullEmailSender que solo registra el
# intento de envío por log, sin fallar y sin llamar a Resend (mismo criterio
# de "fallback explícito, nunca silencioso en producción" que
# ALLOW_INSECURE_JWT_DEV_FALLBACK, ver config.py). Definir un valor real acá
# (una API key de modo test o de prueba de Resend, nunca de producción, sirve
# perfecto para desarrollo local) para probar el envío real end-to-end.
RESEND_API_KEY=

# Dirección "from" con la que Resend envía los correos de THERS. Resend
# permite usar "onboarding@resend.dev" sin verificar ningún dominio propio
# --- pensado explícitamente por Resend para pruebas en desarrollo, según su
# propia documentación de onboarding --- por eso es el valor por defecto acá.
# Para cualquier entorno real hace falta verificar un dominio propio en
# Resend y reemplazar este valor por una dirección de ese dominio.
EMAIL_FROM=onboarding@resend.dev

# Origen del Frontend, usado para construir los enlaces que van dentro de los
# correos (recuperación de contraseña, verificación de email) --
# "<FRONTEND_URL>/reset-password?token=..." / "<FRONTEND_URL>/verify-email?token=...".
# Con el valor de abajo, esos enlaces apuntan al Frontend corriendo en local
# (`npm run dev`, ver Frontend/vite.config.js) -- ajustar a la URL real
# cuando el Frontend esté desplegado en otro origen.
FRONTEND_URL=http://localhost:5173
